{{- $identity :=  "~/.ssh/id_ed25519" -}}
{{- if and (not (stat (expandenv $identity))) (env "SSH_AUTH_SOCK") -}}
{{-   $identity = joinPath .chezmoi.cacheDir "ssh-agent-identity" -}}
{{-   if not (stat $identity) -}}
{{-     $_ := output "sh" "-c" (printf "ssh-add -L | head -n 1 > %s" $identity) -}}
{{-   end -}}
{{- end -}}

encryption = "age"

[age]
    identity = {{ $identity | quote }}
    recipient = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN04bUI6qNwKQre/NLVxsGBYcwjt6zQOvfms3iqM+kS2"
