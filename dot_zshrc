# ~~~~~~~~~~~~~~~ History ~~~~~~~~~~~~~~~~~~~~~~~~


HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt HIST_IGNORE_DUPS  # Don't save duplicate lines
setopt SHARE_HISTORY     # Share history between sessions


# ~~~~~~~~~~~~~~~ Prompt ~~~~~~~~~~~~~~~~~~~~~~~~


PURE_GIT_PULL=0

if [[ "$OSTYPE" == darwin* ]]; then
  fpath+=("$(brew --prefix)/share/zsh/site-functions")
else
  fpath+=($HOME/.zsh/pure)
fi
autoload -U promptinit; promptinit

prompt pure

zstyle :prompt:pure:user color 111
zstyle :prompt:pure:host color 111
zstyle :prompt:pure:path color 120


# enable zsh vi-mode
bindkey -v
export KEYTIMEOUT=1 # make switching between modes faster


# ~~~~~~~~~~~~~~~ Environment Variables ~~~~~~~~~~~~~~~~~~~~~~~~


export EDITOR='/usr/bin/vim'
export VISUAL='/usr/bin/vim'
if command -v nvim > /dev/null ; then
  export EDITOR="nvim"
  export VISUAL="nvim"
fi

export LANG="en_US.UTF-8"


# ~~~~~~~~~~~~~~~ Homebrew ~~~~~~~~~~~~~~~~~~~~~~~~


if [ -d "/home/linuxbrew/.linuxbrew" ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi


# ~~~~~~~~~~~~~~~ Mise ~~~~~~~~~~~~~~~~~~~~~~~~


if command -v mise > /dev/null ; then
  eval "$($HOME/.local/bin/mise activate zsh)"
fi


# ~~~~~~~~~~~~~~~ Completion ~~~~~~~~~~~~~~~~~~~~~~~~


autoload -Uz compinit && compinit

if command -v fzf > /dev/null ; then
  source <(fzf --zsh)
fi

if command -v kubectl > /dev/null ; then
  export KUBECONFIG=$HOME/.kube/config
  source <(kubectl completion zsh)
  compdef __start_kubectl k
fi

if command -v flux > /dev/null ; then
  source <(flux completion zsh)
fi

if command -v chezmoi > /dev/null ; then
  source <(chezmoi completion zsh)
fi

if command -v mise > /dev/null ; then
  source <(mise completion zsh)
fi

if command -v uv &> /dev/null; then
  eval "$(uv generate-shell-completion zsh)"
fi

if command -v uvx &> /dev/null; then
  eval "$(uvx --generate-shell-completion zsh)"
fi


# ~~~~~~~~~~~~~~~ Aliases ~~~~~~~~~~~~~~~~~~~~~~~~


# NeoVim

alias v=nvim


# bat (better cat)

if command -v bat > /dev/null ; then
  alias cat="bat --paging=never"
  alias less="bat"
  alias -g -- --help="--help 2>&1 | bat --language=help --style=plain"
fi


# lsd

alias ls='ls -h --group-directories-first'
if command -v lsd > /dev/null ; then
  alias ls='lsd -h --group-directories-first'
  alias lgit='ls -lFAg'          # complete list with git status
  alias ltree='ls --tree'        # tree
  alias ltreea='ls --tree -A'    # tree with hidden elements
fi
alias l='ls -lF'               # detailed list
alias la='ls -lFA'             # complete list (with hidden elements)
alias lt='ls -lFAtr'           # all elements sorted by last modified


# Git

alias gp="git pull"
alias gs="git status"
alias gd="git diff"
alias lg=lazygit


# Kubernetes

alias k='kubectl'
alias kgp='kubectl get pods'
alias kc='kubectx'
alias kn='kubens'

alias fgk='flux get kustomizations'


# Devpod

alias ds='devpod ssh'
